# Defaults work without any credentials. Export values in your shell to override.
DATABASE_URL=sqlite:///observatory.db
# Optional OTLP HTTP collector:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Optional paid-provider CLI runs only:
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_BASELINE_MODEL=
# LLM_CANDIDATE_MODEL=
# Optional pricing supplied by you, in USD per million tokens. Missing pricing yields null cost.
# LLM_BASELINE_INPUT_USD_PER_MILLION=
# LLM_BASELINE_OUTPUT_USD_PER_MILLION=
# LLM_CANDIDATE_INPUT_USD_PER_MILLION=
# LLM_CANDIDATE_OUTPUT_USD_PER_MILLION=
